{
  "id": "hello",
  "name": "Hello",
  "version": "0.0.1",
  "engines": {
    "argo": ">=0.0.0 <1.0.0"
  },
  "main": "index.tsx",
  "icon": {
    "sf": "powerplug",
    "material": "power"
  },
  "contributes": {
    "nav": [
      {
        "id": "hello",
        "title": "Hello",
        "path": "/"
      }
    ],
    "settings": [
      {
        "key": "greeting",
        "type": "text",
        "label": "Greeting",
        "description": "The heading on the Hello page.",
        "default": "Hello from a Plugin"
      }
    ],
    "slots": ["argo/project/details/v1"]
  },
  "capabilities": [
    {
      "kind": "fetch",
      "host": "jsonplaceholder.typicode.com",
      "reason": "Show a paged remote list in the Hello example."
    }
  ]
}
