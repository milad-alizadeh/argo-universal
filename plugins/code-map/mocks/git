#!/bin/sh
# A fixture git for the Code Map's tests. The Project folder's marker files choose the answer:
# `broken` is not a repository, `large` is a big Project, anything else is a small one.
if [ -e broken ]; then
  printf '%s\n' 'fatal: not a git repository (or any of the parent directories): .git' >&2
  exit 128
fi

large() {
  awk -v kind="$1" 'BEGIN {
    for (i = 0; i < 3000; i++) {
      path = sprintf("packages/feature-%02d/src/components/a-rather-long-section-name-%02d/another-long-folder-name/with-depth/module-%04d.tsx", i % 40, i % 25, i)
      if (kind == "lines") printf "%s\t%d\n", path, (i % 400) + 1
      else if (kind == "branches") printf "%s\t%d\n", path, i % 30
      else printf "%s\t", path
    }
  }' | tr '\t' '\000'
}

if [ "$1" = "grep" ] && [ "$6" = "-e" ]; then
  if [ -e large ]; then large lines; exit 0; fi
  printf '%s\000%s\n' 'src/app.ts' 120 'src/lib/parse.ts' 60 'README.md' 12
  exit 0
fi

if [ "$1" = "grep" ] && [ "$6" = "-E" ]; then
  if [ -e large ]; then large branches; exit 0; fi
  printf '%s\000%s\n' 'src/app.ts' 24 'src/lib/parse.ts' 3
  exit 0
fi

if [ "$1" = "log" ]; then
  if [ -e large ]; then large log; exit 0; fi
  printf '%s\000' 'src/app.ts' 'src/app.ts' 'src/lib/parse.ts' 'docs/removed.md'
  exit 0
fi

printf 'Unsupported fixture command: %s\n' "$*" >&2
exit 2
