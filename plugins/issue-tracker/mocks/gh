#!/bin/sh
# Issue 43 is a sub-Issue of 42 and blocked by it. Issue 42 changes status; gh refuses to change issue 43's. Closed searches find nothing.
issue() {
  printf '{"number":%s,"title":"%s","state":"OPEN","stateReason":"","body":"This Issue came from the fixture gh executable.","labels":[{"name":"fixture","color":"d73a4a"}],"assignees":[{"login":"octocat"}],"parent":%s,"url":"https://github.com/owner/repository/issues/%s",%s}' "$1" "$2" "$3" "$1" "$4"
}
relation() {
  printf '{"number":%s,"title":"%s","state":"OPEN","url":"https://github.com/owner/repository/issues/%s"}' "$1" "$2" "$1"
}
issue_42() {
  issue 42 'Fixture issue from GitHub' null \
    "\"blockedBy\":{\"nodes\":[],\"totalCount\":0},\"subIssues\":{\"nodes\":[$(relation 43 'Fixture issue gh cannot change')],\"totalCount\":1},\"subIssuesSummary\":{\"completed\":0,\"total\":1,\"percentCompleted\":0}"
}
issue_43() {
  issue 43 'Fixture issue gh cannot change' '{"number":42}' \
    "\"blockedBy\":{\"nodes\":[$(relation 42 'Fixture issue from GitHub')],\"totalCount\":1},\"subIssues\":{\"nodes\":[],\"totalCount\":0},\"subIssuesSummary\":{\"completed\":0,\"total\":0,\"percentCompleted\":0}"
}
if [ "$1" = "auth" ] && [ "$2" = "status" ]; then
  exit 0
fi
if [ "$1" = "issue" ] && [ "$2" = "list" ]; then
  case "$8" in
    *is:closed*) printf '%s\n' '[]' ;;
    *) printf '[%s,%s]\n' "$(issue_42)" "$(issue_43)" ;;
  esac
  exit 0
fi
if [ "$1" = "api" ] && [ "$4" = "search/issues" ]; then
  case "$6" in
    *is:closed*) printf '%s\n' '{"total_count":0,"items":[]}' ;;
    *) printf '%s\n' '{"total_count":2,"items":[]}' ;;
  esac
  exit 0
fi
if [ "$1" = "label" ] && [ "$2" = "list" ]; then
  printf '%s\n' '[{"name":"fixture"},{"name":"good first issue"}]'
  exit 0
fi
if [ "$1" = "issue" ] && [ "$2" = "view" ]; then
  if [ "$3" = "43" ]; then issue_43; else issue_42; fi
  printf '\n'
  exit 0
fi
if [ "$1" = "issue" ] && { [ "$2" = "close" ] || [ "$2" = "reopen" ]; }; then
  if [ "$3" = "43" ]; then
    # Slow enough for the App to draw the new status before it rolls back.
    sleep 1
    printf 'GraphQL: Could not %s the issue.\n' "$2" >&2
    exit 1
  fi
  exit 0
fi
printf 'Unsupported fixture gh command: %s\n' "$*" >&2
exit 2
