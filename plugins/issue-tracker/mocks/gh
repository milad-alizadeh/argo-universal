#!/bin/sh
# Issue 42 changes status; gh refuses to change issue 43's.
issue() {
  printf '{"number":%s,"title":"%s","state":"OPEN","body":"This Issue came from the fixture gh executable.","labels":[{"name":"fixture"}],"assignees":[{"login":"octocat"}],"url":"https://github.com/owner/repository/issues/%s"}' "$1" "$2" "$1"
}
issue_42() { issue 42 'Fixture issue from GitHub'; }
issue_43() { issue 43 'Fixture issue gh cannot change'; }
if [ "$1" = "auth" ] && [ "$2" = "status" ]; then
  exit 0
fi
if [ "$1" = "issue" ] && [ "$2" = "list" ]; then
  if [ "$6" = "closed" ]; then
    printf '%s\n' '[]'
    exit 0
  fi
  printf '[%s,%s]\n' "$(issue_42)" "$(issue_43)"
  exit 0
fi
if [ "$1" = "issue" ] && [ "$2" = "view" ]; then
  if [ "$3" = "43" ]; then issue_43; else issue_42; fi
  printf '\n'
  exit 0
fi
if [ "$1" = "issue" ] && { [ "$2" = "close" ] || [ "$2" = "reopen" ]; }; then
  if [ "$3" = "43" ]; then
    # Slow enough for the App to draw the new status before it rolls back.
    sleep 1
    printf 'GraphQL: Could not %s the issue.\n' "$2" >&2
    exit 1
  fi
  exit 0
fi
printf 'Unsupported fixture gh command: %s\n' "$*" >&2
exit 2
