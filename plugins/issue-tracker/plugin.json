{
  "id": "issue-tracker",
  "name": "Issue tracker",
  "version": "0.0.1",
  "engines": {
    "argo": ">=0.0.0 <1.0.0"
  },
  "main": "index.tsx",
  "icon": {
    "sf": "record.circle",
    "material": "adjust"
  },
  "contributes": {
    "nav": [
      {
        "id": "issues",
        "title": "Issues",
        "path": "/"
      }
    ],
    "slots": ["argo/project/details/v1"],
    "operations": [
      {
        "name": "attach",
        "label": "Attach Issue to Session",
        "description": "Connect the calling Session to an Issue it is implementing, so the Issue's page lists it.",
        "tier": "act",
        "keywords": ["issue", "session", "connect"],
        "params": {
          "number": {
            "type": "number",
            "description": "The Issue number to attach.",
            "required": true
          },
          "projectId": {
            "type": "string",
            "description": "The Project the Issue belongs to; the caller's own Project by default."
          }
        }
      },
      {
        "name": "detach",
        "label": "Detach Issue from Session",
        "description": "Disconnect the calling Session from an Issue it is no longer working on.",
        "tier": "act",
        "keywords": ["issue", "session", "disconnect"],
        "params": {
          "number": {
            "type": "number",
            "description": "The Issue number to detach.",
            "required": true
          },
          "projectId": {
            "type": "string",
            "description": "The Project the Issue belongs to; the caller's own Project by default."
          }
        }
      }
    ]
  },
  "capabilities": [
    {
      "kind": "sessions:read"
    },
    {
      "kind": "process:exec",
      "command": "gh",
      "args": ["auth", "status"],
      "env": ["GH_HOST", "GH_TOKEN"]
    },
    {
      "kind": "process:exec",
      "command": "gh",
      "args": [
        "issue",
        "list",
        "--repo",
        "*",
        "--state",
        "all",
        "--search",
        "*",
        "--limit",
        "*",
        "--json",
        "*"
      ],
      "env": ["GH_HOST", "GH_TOKEN"]
    },
    {
      "kind": "process:exec",
      "command": "gh",
      "args": [
        "api",
        "-X",
        "GET",
        "search/issues",
        "-f",
        "*",
        "-f",
        "per_page=1"
      ],
      "env": ["GH_HOST", "GH_TOKEN"]
    },
    {
      "kind": "process:exec",
      "command": "gh",
      "args": ["label", "list", "--repo", "*", "--limit", "*", "--json", "*"],
      "env": ["GH_HOST", "GH_TOKEN"]
    },
    {
      "kind": "process:exec",
      "command": "gh",
      "args": ["issue", "view", "*", "--repo", "*", "--json", "*"],
      "env": ["GH_HOST", "GH_TOKEN"]
    },
    {
      "kind": "process:exec",
      "command": "gh",
      "args": ["issue", "close", "*", "--repo", "*"],
      "env": ["GH_HOST", "GH_TOKEN"]
    },
    {
      "kind": "process:exec",
      "command": "gh",
      "args": ["issue", "reopen", "*", "--repo", "*"],
      "env": ["GH_HOST", "GH_TOKEN"]
    }
  ]
}
