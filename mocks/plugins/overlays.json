{
  "type": "Stack",
  "key": "overlays",
  "props": {
    "direction": "column",
    "gap": 4
  },
  "children": [
    {
      "type": "Alert",
      "key": "alert",
      "props": {
        "open": false,
        "title": "Alert title",
        "message": "Alert wire content",
        "onOpenChange": {
          "bind": "alertOpen"
        }
      },
      "children": [
        {
          "type": "Action",
          "key": "apply",
          "props": {
            "label": "Apply alert",
            "onPress": {
              "operation": "applyChanges",
              "args": {}
            }
          },
          "children": [],
          "slots": {}
        },
        {
          "type": "Action",
          "key": "cancel",
          "props": {
            "label": "Cancel alert",
            "role": "cancel",
            "onPress": {
              "operation": "discardChanges",
              "args": {}
            }
          },
          "children": [],
          "slots": {}
        }
      ],
      "slots": {}
    },
    {
      "type": "Sheet",
      "key": "sheet",
      "props": {
        "open": false,
        "label": "Sheet title",
        "onOpenChange": {
          "bind": "sheetOpen"
        }
      },
      "children": [
        {
          "type": "Stack",
          "key": "body",
          "props": {
            "direction": "column",
            "gap": 4
          },
          "children": [
            {
              "type": "FieldGroup",
              "key": "field",
              "props": {},
              "slots": {},
              "children": [
                {
                  "type": "FieldGroup.Section",
                  "key": "section",
                  "props": {},
                  "slots": {},
                  "children": [
                    {
                      "type": "FieldGroup.TextField",
                      "key": "name",
                      "props": {
                        "title": "Overlay name",
                        "value": "Argo",
                        "onChangeText": {
                          "bind": "name"
                        }
                      },
                      "children": [],
                      "slots": {}
                    }
                  ]
                }
              ]
            },
            {
              "type": "Button",
              "key": "cancel",
              "props": {
                "label": "Cancel sheet",
                "onPress": {
                  "operation": "cancelRename",
                  "args": {}
                }
              },
              "children": [],
              "slots": {}
            },
            {
              "type": "Button",
              "key": "apply",
              "props": {
                "label": "Apply sheet",
                "onPress": {
                  "operation": "rename",
                  "args": {}
                }
              },
              "children": [],
              "slots": {}
            }
          ],
          "slots": {}
        }
      ],
      "slots": {}
    },
    {
      "type": "Button",
      "key": "share",
      "props": {
        "label": "Share content",
        "onPress": {
          "action": "share",
          "title": "Argo",
          "message": "Shared from a Plugin"
        }
      },
      "children": [],
      "slots": {}
    },
    {
      "type": "Button",
      "key": "pop",
      "props": {
        "label": "Back one page",
        "onPress": {
          "action": "pop"
        }
      },
      "children": [],
      "slots": {}
    }
  ],
  "slots": {}
}
