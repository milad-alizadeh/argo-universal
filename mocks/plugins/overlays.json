{
  "type": "Stack",
  "key": "overlays",
  "props": {
    "direction": "column",
    "gap": 4
  },
  "children": [
    {
      "type": "Button",
      "key": "alert-trigger",
      "props": {
        "label": "Open alert",
        "onPress": {
          "action": "alert",
          "title": "Alert title",
          "content": {
            "type": "Text",
            "key": "message",
            "props": {
              "children": "Alert wire content"
            },
            "children": [],
            "slots": {}
          },
          "confirmLabel": "Apply alert",
          "cancelLabel": "Cancel alert",
          "onConfirm": {
            "$event": "onConfirm"
          },
          "onDismiss": {
            "$event": "onDismiss"
          }
        }
      },
      "children": [],
      "slots": {}
    },
    {
      "type": "Button",
      "key": "dialog-trigger",
      "props": {
        "label": "Open dialog",
        "onPress": {
          "action": "dialog",
          "title": "Dialog title",
          "content": {
            "type": "Stack",
            "key": "body",
            "props": {
              "direction": "column",
              "gap": 4
            },
            "children": [
              {
                "type": "TextInput",
                "key": "field",
                "props": {
                  "label": "Overlay name",
                  "value": "Argo",
                  "onChangeText": {
                    "$event": "onChangeText",
                    "$path": [
                      "onPress",
                      "content",
                      "children",
                      "0",
                      "props",
                      "onChangeText"
                    ]
                  }
                },
                "children": [],
                "slots": {}
              }
            ],
            "slots": {}
          },
          "confirmLabel": "Apply dialog",
          "cancelLabel": "Cancel dialog",
          "onConfirm": {
            "$event": "onConfirm"
          },
          "onDismiss": {
            "$event": "onDismiss"
          }
        }
      },
      "children": [],
      "slots": {}
    },
    {
      "type": "Button",
      "key": "sheet-trigger",
      "props": {
        "label": "Open sheet",
        "onPress": {
          "action": "sheet",
          "title": "Sheet title",
          "content": {
            "type": "Stack",
            "key": "body",
            "props": {
              "direction": "column",
              "gap": 4
            },
            "children": [
              {
                "type": "Text",
                "key": "message",
                "props": {
                  "children": "Sheet wire content"
                },
                "children": [],
                "slots": {}
              },
              {
                "type": "Button",
                "key": "close",
                "props": {
                  "label": "Close from content",
                  "onPress": {
                    "action": "dismiss"
                  }
                },
                "children": [],
                "slots": {}
              }
            ],
            "slots": {}
          },
          "confirmLabel": "Apply sheet",
          "cancelLabel": "Cancel sheet",
          "onConfirm": {
            "$event": "onConfirm"
          },
          "onDismiss": {
            "$event": "onDismiss"
          }
        }
      },
      "children": [],
      "slots": {}
    },
    {
      "type": "Button",
      "key": "share",
      "props": {
        "label": "Share content",
        "onPress": {
          "action": "share",
          "title": "Argo",
          "message": "Shared from a Plugin"
        }
      },
      "children": [],
      "slots": {}
    },
    {
      "type": "Button",
      "key": "pop",
      "props": {
        "label": "Back one page",
        "onPress": {
          "action": "pop"
        }
      },
      "children": [],
      "slots": {}
    }
  ],
  "slots": {}
}
