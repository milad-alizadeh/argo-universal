{
  "type": "Screen",
  "key": "page",
  "props": {
    "title": "Issues",
    "search": {
      "label": "Search Issues"
    },
    "value": "",
    "onChangeText": {
      "bind": "query"
    }
  },
  "children": [
    {
      "type": "Text",
      "key": "content",
      "props": {
        "children": "Open Issues"
      },
      "children": [],
      "slots": {}
    }
  ],
  "slots": {
    "actions": [
      {
        "type": "Action",
        "key": "filters",
        "props": {
          "label": "Filters",
          "icon": "filters",
          "onPress": {
            "operation": "openFilters",
            "args": {}
          }
        },
        "children": [],
        "slots": {}
      },
      {
        "type": "Action",
        "key": "sort",
        "props": {
          "label": "Sort",
          "icon": "filter-list",
          "badge": {
            "kind": "count",
            "count": 2
          }
        },
        "children": [
          {
            "type": "Action.Section",
            "key": "order",
            "props": {
              "title": "Order"
            },
            "children": [
              {
                "type": "Action",
                "key": "newest",
                "props": {
                  "label": "Newest",
                  "icon": "arrow-down",
                  "onPress": {
                    "pageState": {
                      "order": "newest"
                    }
                  }
                },
                "children": [],
                "slots": {}
              },
              {
                "type": "Action",
                "key": "oldest",
                "props": {
                  "label": "Oldest",
                  "icon": "arrow-up",
                  "onPress": {
                    "pageState": {
                      "order": "oldest"
                    }
                  }
                },
                "children": [],
                "slots": {}
              }
            ],
            "slots": {}
          }
        ],
        "slots": {}
      }
    ],
    "primaryAction": [
      {
        "type": "Action",
        "key": "new",
        "props": {
          "label": "New Issue",
          "icon": "add",
          "onPress": {
            "operation": "newIssue",
            "args": {}
          }
        },
        "children": [],
        "slots": {}
      }
    ]
  }
}
