{
  "name": "argo-universal",
  "private": true,
  "type": "module",
  "scripts": {
    "argo": "node --experimental-vm-modules --import tsx apps/server/src/main.ts",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "docs:build": "pnpm --filter @repo/contracts generate:plugin-reference",
    "dev": "turbo run dev",
    "dev:storybook": "pnpm --filter @repo/storybook storybook",
    "format": "oxfmt",
    "postinstall": "sherif",
    "perf": "pnpm --filter @repo/universal-app build && pnpm --filter @repo/tools perf",
    "quality:dead-code": "knip --no-progress --max-issues 0",
    "quality:duplication": "jscpd --config .jscpd.json --baseline .jscpd-baseline.json --fail-on-new-clones=0 apps packages tooling tools e2e mocks",
    "quality:lint": "sherif && oxfmt --check && node tools/check-lint-waivers.mts && node tools/check-comments.mts && node tools/check-test-suffix.mts && node tools/check-story-titles.mts && pnpm quality:duplication",
    "quality:checks": "pnpm quality:lint && turbo run check-types test --continue=dependencies-successful",
    "quality": "pnpm quality:checks && pnpm test:stories",
    "storybook:mac": "pnpm --filter @repo/desktop storybook:mac",
    "test": "vitest run",
    "test:e2e": "turbo run test:web --filter=@repo/e2e",
    "test:e2e:electron": "turbo run test:electron --filter=@repo/e2e",
    "test:stories": "turbo run test:stories"
  },
  "devDependencies": {
    "jscpd": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sherif": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x"
  }
}
