{
  "name": "argo-universal",
  "private": true,
  "type": "module",
  "scripts": {
    "argo": "node apps/cli/bin/argo.mjs",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "docs:build": "pnpm generate:plugin-kit && pnpm --filter @repo/contracts generate:plugin-reference",
    "dev": "turbo run dev",
    "dev:storybook": "pnpm generate:plugin-kit && pnpm --filter @repo/storybook storybook",
    "dev:storybook:all": "pnpm generate:plugin-kit && EXPO_PUBLIC_STORYBOOK_ANDROID_WS_HOST=10.0.2.2 node tools/start-storybook-previews.mts",
    "format": "oxfmt",
    "postinstall": "sherif && pnpm generate:plugin-kit",
    "new:story": "node --import tsx tools/new-story.mts",
    "perf": "pnpm --filter @repo/universal-app build && pnpm --filter @repo/tools perf",
    "check:story-renders": "node --import tsx tools/check-story-renders.mts",
    "quality:dead-code": "knip --no-progress --max-issues 0",
    "quality:duplication": "jscpd --config .jscpd.json --baseline .jscpd-baseline.json --fail-on-new-clones=0 apps packages tooling tools e2e mocks",
    "quality:lint": "sherif && node tools/check-operation-mutations.mts && node --import tsx tools/generate-operations.mts --check && node --import tsx packages/contracts/tools/registry/generate-validators.mts --check && node tools/check-canvaskit.mts && oxfmt --check && node tools/check-lint-waivers.mts && node tools/check-comments.mts && node tools/check-test-suffix.mts && node tools/check-test-only-imports.mts && node tools/check-story-titles.mts && node --import tsx tools/check-story-gates.mts && node --import tsx tools/check-kit-pairing.mts && pnpm quality:duplication",
    "quality:checks": "pnpm quality:lint && turbo run check-types test --continue=dependencies-successful",
    "quality": "node tooling/browser-suite-lock/hold.ts quality:checks test:stories",
    "storybook:mac": "pnpm generate:plugin-kit && pnpm --filter @repo/desktop storybook:mac",
    "test": "pnpm generate:plugin-kit && vitest run",
    "test:e2e": "turbo run test:web --filter=@repo/e2e",
    "test:e2e:electron": "turbo run test:electron --filter=@repo/e2e",
    "test:stories": "turbo run test:stories",
    "verify": "node tools/verify.mts",
    "generate:plugin-kit": "turbo run generate:plugin-kit",
    "check:plugin-generation": "node tools/check-plugin-generation.mts"
  },
  "devDependencies": {
    "jscpd": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sherif": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x"
  }
}
