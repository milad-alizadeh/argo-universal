{
  "name": "argo-universal",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "oxfmt --check && oxlint --type-aware",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "dev": "turbo run dev",
    "dev:storybook": "pnpm --filter @repo/storybook storybook",
    "format": "oxfmt",
    "lint": "oxlint --type-aware",
    "postinstall": "sherif",
    "quality:dead-code": "knip --no-progress --max-issues 0",
    "quality:duplication": "jscpd --config .jscpd.json --baseline .jscpd-baseline.json --fail-on-new-clones=0 apps packages tooling tools e2e mocks",
    "quality:hoisting": "node tools/hoist-check.mts",
    "quality": "sherif && oxfmt --check && oxlint --type-aware --deny-warnings && node tools/not-yet-cleared.mts check && node tools/check-comments.mts && pnpm quality:duplication && turbo run check-types test --continue=dependencies-successful",
    "sherif": "sherif",
    "test": "vitest run",
    "test:e2e": "turbo run test:web --filter=@repo/e2e",
    "test:e2e:electron": "turbo run test:electron --filter=@repo/e2e"
  },
  "devDependencies": {
    "jscpd": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sherif": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x"
  }
}
