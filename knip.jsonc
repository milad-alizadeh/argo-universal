{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["**/*.gen.*"],
  "workspaces": {
    "packages/client": {
      // Metro selects platform modules by filename rather than by a literal import.
      "entry": ["src/**/*.@(android|ios|native|web).{ts,tsx}"]
    },
    "packages/agents": {
      // The protocol generator is also a supported manual regeneration command.
      "entry": ["codex/generate-protocol.ts"]
    },
    "apps/desktop": {
      // Knip has no Electron Forge plugin, so forge.config.mts and the Vite `build` entries it names by string are listed by hand.
      "entry": [
        "forge.config.mts",
        "vite.main.config.mts",
        "vite.preload.config.mts",
        "src/main/main.ts",
        "src/preload/preload.ts"
      ],
      // A shell builtin in the dev and start scripts, not an npm binary.
      "ignoreBinaries": ["unset"]
    },
    "apps/server": {
      // The Supervisor and E2E launch these Engine entries by path in a separate process.
      "entry": ["src/engine/main.ts", "mocks/e2e-engine.ts"]
    },
    "packages/engine": {
      // macOS supplies the computer-name command.
      "ignoreBinaries": ["scutil"]
    },
    "apps/universal-app": {
      // Native modules the app must list itself so Expo autolinks them; @repo/client, expo-symbols and Expo Router reach them at runtime.
      "ignoreDependencies": [
        "@expo/ui",
        "expo-clipboard",
        "expo-file-system",
        "expo-font",
        "expo-haptics",
        "expo-image-picker",
        "react-native-svg",
        // Knip assumes OTA updates are installed unless Expo config explicitly disables them.
        "expo-updates"
      ],
      // Config plugins that app.json names by path.
      "entry": ["plugins/*.mjs"]
    },
    "apps/storybook": {
      // Peers of @repo/client's primitives, listed here so the Storybook Vite build resolves them.
      "ignoreDependencies": [
        "react-native-gesture-handler",
        "react-native-safe-area-context",
        "react-native-svg"
      ]
    },
    "e2e": {
      // playwright-bdd discovers step definitions through the config's steps glob.
      "entry": ["steps/**/*.ts"],
      // Listed so Turborepo hashes the Server, App, and Desktop into the e2e tasks; the specs reach them over HTTP and Electron, not imports.
      "ignoreDependencies": [
        "@repo/desktop",
        "@repo/server",
        "@repo/universal-app"
      ]
    },
    "tools": {
      // Each script runs by path from a package script, a hook config or by hand.
      "entry": ["*.{mts,mjs}"],
      // profile-shell.mjs resolves Playwright from @repo/e2e on purpose.
      "ignoreDependencies": ["@playwright/test"]
    }
  }
}
