{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Vendored anti-slop keeps upstream's files whole, including the Effect rules Argo does not register.
  "ignore": ["**/*.gen.*", "tooling/oxlint/anti-slop/**"],
  // These aliases give the same value two domain names used by consumers.
  "ignoreIssues": {
    // Kept for the planned form controls.
    "packages/kit/src/form-focus.tsx": ["exports"],
    "packages/contracts/src/plugins/accounts.ts": ["duplicates"],
    "packages/engine/src/agents/acp/connection/draft-subagent-fixtures.ts": [
      "duplicates"
    ]
  },
  "workspaces": {
    ".": {
      // Skills invoke these scripts directly by path.
      "entry": [
        ".agents/skills/expo-ui/scripts/list-components.js",
        ".agents/skills/apple-design/scripts/pull-hig.mjs"
      ],
      // Run as binaries by check-rule-allowlists.mts, the edit hooks and `pnpm quality:lint`, not by a package script knip reads.
      "ignoreDependencies": ["oxlint", "oxlint-tsgolint"]
    },
    "packages/client": {
      // Metro selects platform modules by filename rather than by a literal import.
      "entry": ["src/**/*.@(android|ios|native|web).{ts,tsx}"]
    },
    "packages/kit": {
      // Metro selects platform modules by filename rather than by a literal import.
      "entry": ["src/**/*.@(android|ios|native|web).{ts,tsx}"]
    },
    "apps/desktop": {
      // Knip has no Electron Forge plugin, so forge.config.mts and the Vite `build` entries it names by string are listed by hand.
      "entry": [
        "forge.config.mts",
        "vite.main.config.mts",
        "vite.preload.config.mts",
        "src/main/main.ts",
        "src/preload/preload.ts",
        // `scripts/storybook-mac.mts` builds this by path.
        "src/storybook/storybook-window.ts"
      ],
      // A shell builtin in the dev and start scripts, not an npm binary.
      "ignoreBinaries": ["unset"]
    },
    "packages/process": {
      // The lifecycle tests launch these by path.
      "entry": ["mocks/child-fixture.mjs", "mocks/parent-fixture.ts"]
    },
    "apps/server": {
      // The Supervisor and E2E launch these Engine entries by path in a separate process.
      "entry": [
        "src/engine/main.ts",
        "mocks/e2e-engine.ts",
        "mocks/e2e-supervisor.ts"
      ]
    },
    "packages/engine": {
      // The recorder runs by path; plugin fixtures are loaded by manifest or fixture name.
      "entry": [
        "mocks/user-message-recording.ts",
        // tools/record-*.mts launch these through Vitest; they import the *-scenario files.
        "mocks/deep-feed-recording.ts",
        "mocks/report-recording.ts",
        "mocks/plugin-runtime/*.{js,mjs,cjs}",
        "mocks/plugins/first-party/*/index.js"
      ]
    },
    "packages/plugin-kit": {
      // The `argo-plugin` bin runs this entry by path through tsx; the sign-in fixtures are copied or read by folder.
      "entry": ["cli/main.ts", "mocks/sign-in-plugins/*/index.tsx"]
    },
    "apps/universal-app": {
      // Native modules the app must list itself so Expo autolinks them; @repo/client, expo-symbols and Expo Router reach them at runtime.
      "ignoreDependencies": [
        "@expo/material-symbols",
        "burnt",
        "expo-asset",
        "expo-document-picker",
        "expo-audio",
        "expo-clipboard",
        "expo-crypto",
        "expo-file-system",
        "expo-font",
        "expo-glass-effect",
        "expo-image-picker",
        "expo-secure-store",
        "expo-video",
        "react-native-tcp-socket",
        "react-native-zeroconf",
        // Knip assumes OTA updates are installed unless Expo config explicitly disables them.
        "expo-updates"
      ],
      // Config plugins that app.json names by path.
      // The .d.mts types each plugin's .mjs for its test.
      "entry": ["plugins/*.mjs", "plugins/*.d.mts"]
    },
    "apps/storybook": {
      // The story render checker selects this Vitest config by path.
      "entry": ["vitest.renders.config.ts"],
      // Peers of @repo/kit's primitives, listed here so the Storybook Vite build resolves them.
      // babel-plugin-react-compiler is named by a string in .storybook/react-compiler.ts, which @vitejs/plugin-react resolves.
      // @repo/kit is listed so Turborepo hashes the kit into the Storybook tasks; its stories reach the build through the stories globs, not an import.
      "ignoreDependencies": [
        "@repo/kit",
        "babel-plugin-react-compiler",
        "expo",
        "react-native-gesture-handler",
        "react-native-safe-area-context",
        "react-native-svg"
      ]
    },
    "e2e": {
      // playwright-bdd discovers steps by glob; the E2E Server loads Plugins by manifest.
      "entry": [
        "steps/**/*.ts",
        "mocks/plugins/*/*.js",
        "mocks/github-plugins/*/*.js"
      ],
      // Listed so Turborepo hashes the Server, App, and Desktop into the e2e tasks; the specs reach them over HTTP and Electron, not imports.
      "ignoreDependencies": [
        "@repo/desktop",
        "@repo/server",
        "@repo/universal-app",
        // The Engine bundle marks these external and resolves them from E2E.
        "esbuild",
        "node-pty",
        "@napi-rs/keyring"
      ]
    },
    "tools": {
      // Each script runs by path from a package script, a hook config or by hand.
      "entry": ["*.{mts,mjs}", "storybook-sync-port.d.ts"]
    }
  }
}
