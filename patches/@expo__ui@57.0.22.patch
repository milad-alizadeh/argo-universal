+// A host that changes around the open bar (a header dropping its other items) can re-attach this
+// view, which moves focus elsewhere; the open field takes it back so typing still lands in it.
+@Composable
+private fun RefocusOnReattach(expanded: Boolean, focusRequester: FocusRequester) {
