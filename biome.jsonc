{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@repo/biome/biome.jsonc"],
  // The shared config leaves version control off; the root turns it on so .gitignore applies.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/.expo",
      "!!**/.turbo",
      "!!**/.vitest",
      "!!**/coverage",
      "!!**/storybook-static",
      "!!**/playwright-report",
      "!!**/blob-report",
      "!!**/test-results",
      "!packages/db/drizzle",
      "!**/.rnstorybook/storybook.requires.ts",
      "!**/*.gen.*",
      // Metro and `uniwind generate-artifacts` rewrite this file on every run.
      "!**/uniwind-types.d.ts",
      // Icon Composer bundles are written by Apple's tool, not by hand.
      "!**/*.icon",
      // Installed by the skills tool, not written in this repo.
      "!!.agents",
      "!!.claude",
      "!!skills-lock.json"
    ]
  },
  "overrides": [
    {
      // Tests, stories and mocks state their inputs and expectations as literals.
      "includes": [
        "**/*.test.*",
        "**/*.stories.*",
        "**/*.mocks.*",
        "e2e/**",
        "**/mocks/**",
        "tools/**"
      ],
      "linter": {
        "rules": {
          "style": { "noMagicNumbers": "off" }
        }
      }
    },
    {
      // Icons take a named size (sm, md or lg) instead of a number or size-* class.
      "includes": ["packages/client/src/**"],
      "plugins": ["./tooling/biome/icon-size.grit"]
    },
    {
      // Brand-kit SVGs stay byte-for-byte original; rendering components provide accessible labels.
      "includes": ["packages/agents/*/assets/*.svg"],
      "linter": {
        "rules": {
          "a11y": { "noSvgWithoutTitle": "off" }
        }
      }
    },
    {
      // An adapter is plain functions; the one Agent machine in packages/agents/src owns the lifecycle.
      "includes": ["packages/agents/*/**", "!packages/agents/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "xstate": "Adapters are plain functions; see ADR-0015.",
                  "zod": "Use vendor SDK or generated protocol types; the Feed validates adapter changes (ADR-0015)."
                },
                "patterns": [
                  {
                    "group": ["zod/*"],
                    "message": "Use vendor SDK or generated protocol types (ADR-0015)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Recording converters and mock CLIs use the same vendor types as their adapters.
      "includes": ["mocks/cli/*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": "Use vendor SDK or generated protocol types; validate generic recording and transport envelopes in mocks/cli (ADR-0015)."
                },
                "patterns": [
                  {
                    "group": ["zod/*"],
                    "message": "Use vendor SDK or generated protocol types (ADR-0015)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Uniwind themes repeat each variable per @variant and use its own CSS functions, such as hairlineWidth().
      "includes": ["tooling/uniwind/*.css"],
      "linter": {
        "rules": {
          "correctness": { "noUnknownFunction": "off" },
          "suspicious": { "noDuplicateCustomProperties": "off" }
        }
      }
    },
    {
      // Shared tsconfigs carry comments like tsconfig.json, which Biome knows only by name.
      "includes": ["tooling/typescript/*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    }
  ]
}
