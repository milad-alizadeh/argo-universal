{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/agent-hooks.mts\" after-edit",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__paper__(update_styles|write_html|set_text_content|rename_nodes|delete_nodes|duplicate_nodes|move_nodes)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/paper-drift-hook.mts\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/agent-hooks.mts\" before-stop",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
