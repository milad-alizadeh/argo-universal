{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // The Prickles pack, Argo's rules on top, then the folders that do not meet them yet (ADR-0016, ADR-0017).
  "extends": [
    "./tooling/oxlint/prickles.json",
    "./tooling/oxlint/argo.json",
    "./tooling/oxlint/kit-styling-allowlist.json",
    "./tooling/oxlint/not-yet-cleared.json"
  ],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    "**/.turbo/**",
    "**/.features-gen/**",
    "packages/db/drizzle/**",
    "**/.rnstorybook/storybook.requires.ts",
    "**/*.gen.*",
    // Metro and `uniwind generate-artifacts` rewrite this file on every run.
    "**/uniwind-types.d.ts",
    // Installed by the skills tool and agent clients, not written in this repo.
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    // Vendored upstream code in upstream style; anti-slop/UPSTREAM.md says how to update it.
    "tooling/oxlint/anti-slop/**"
  ]
}
