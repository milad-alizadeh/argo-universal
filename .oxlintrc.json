{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // The Prickles pack and Argo's rules (ADR-0016, ADR-0017).
  "extends": ["./tooling/oxlint/prickles.json", "./tooling/oxlint/argo.json"],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    "**/.turbo/**",
    "**/.features-gen/**",
    "packages/db/drizzle/**",
    "**/.rnstorybook/storybook.requires.ts",
    "**/*.gen.*",
    // Metro and `uniwind generate-artifacts` rewrite this file on every run.
    "**/uniwind-types.d.ts",
    // Ported line for line from RareFormLabs/thinking-orbs (MIT), so it stays diffable against the original.
    "packages/kit/src/primitives/status/orb/engine/**",
    // Installed by the skills tool and agent clients, not written in this repo.
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    // Vendored upstream code in upstream style; anti-slop/UPSTREAM.md says how to update it.
    "tooling/oxlint/anti-slop/**"
  ]
}
