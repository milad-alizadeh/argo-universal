language js

// Client takes only types from @repo/api; a value import would bundle the server router into the App.
or {
  or {
    JsImport() as $statement,
    JsExport() as $statement
  } where {
    $statement <: contains JsModuleSource() as $source,
    not $statement <: r"(?:import|export)\s+type\s[\s\S]*"
  },
  `import($source)`,
  `require($source)`
} where {
  $source <: r"['\"]@repo/api(?:/.*)?['\"]",
  register_diagnostic(span=$source, message="client imports @repo/api only with `import type`; move runtime data to @repo/contracts, or keep it in a test, story or mock.")
}
