language js

// Approximates unicorn/consistent-function-scoping: a named inner function that reads or writes nothing its enclosing function binds.
or {
  JsFunctionDeclaration(id=$name) as $inner,
  JsVariableDeclarator(id=$name, initializer=JsInitializerClause(expression=or {
    JsArrowFunctionExpression(),
    JsFunctionExpression()
  } as $inner))
} where {
  $name <: within JsFunctionBody() as $outerBody,
  $outerBody <: within or {
    JsFunctionDeclaration(),
    JsFunctionExpression(),
    JsArrowFunctionExpression(),
    JsMethodClassMember(),
    JsMethodObjectMember(),
    JsGetterClassMember(),
    JsSetterClassMember(),
    JsConstructorClassMember()
  } as $outer,
  // Like unicorn: skip React hook callbacks and immediately invoked functions.
  not $outerBody <: within JsCallExpression(callee=$callee) where {
    or { $callee <: r"use[A-Z][\s\S]*", $callee <: contains $outerBody }
  },
  not $inner <: contains JsThisExpression(),
  // A `let` placeholder such as `let stop = () => {}` is reassigned later, so it cannot move.
  not $inner <: within JsVariableDeclaration() as $declaration where {
    $declaration <: r"let\s[\s\S]*"
  },
  not $inner <: contains or {
    JsReferenceIdentifier(),
    JsxReferenceIdentifier(),
    JsIdentifierAssignment()
  } as $reference where {
    $reference <: r"(.+)"($referenceText),
    $outer <: contains JsIdentifierBinding() as $binding where {
      $binding <: r"(.+)"($bindingText),
      $bindingText <: $referenceText
    },
    not $inner <: contains JsIdentifierBinding() as $own where {
      $own <: r"(.+)"($ownText),
      $ownText <: $referenceText
    }
  },
  register_diagnostic(span=$name, message="This function uses nothing from the function around it; move it up a scope, to module scope when it uses only imports (unicorn/consistent-function-scoping).")
}
