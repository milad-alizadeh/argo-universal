{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  // Biome finds this file inside the workspace, so it must not claim to be a second root.
  "root": false,
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    // Owner's style: two-space indent.
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    // Biome cannot read pnpm catalog versions, so domains are named here.
    "domains": { "test": "recommended", "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "style": {
        "noNestedTernary": "error",
        "noMagicNumbers": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useCollapsedIf": "error",
        // Off for the vendored primitives.
        "noUselessElse": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noImportCycles": "error",
        "noFocusedTests": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error"
      },
      "nursery": {
        // False is explicit and harmless: unset also passes, and true would flag 3 switches that already have a default.
        "useExhaustiveSwitchCases": {
          "level": "error",
          "options": { "requireExplicitCase": false }
        },
        // Type-aware rules work only at the top level, never inside an override.
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      // Owner's style: single quotes.
      "quoteStyle": "single"
    }
  },
  // Uniwind's global.css and theme.css use Tailwind 4 directives such as @theme.
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
