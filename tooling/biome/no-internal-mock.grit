language js

or {
  `vi.mock($path)`,
  `vi.mock($path, $_)`,
  `vi.doMock($path)`,
  `vi.doMock($path, $_)`
} as $call where {
  $path <: or {
    r"['\"`]\..*",
    r"['\"`]@repo/.*"
  },
  register_diagnostic(span=$call, message="Pass a fake through the port (machine.provide or a parameter) instead of vi.mock on an own module.")
}
