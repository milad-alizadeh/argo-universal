    // The pack's own rules, in its order, with its comments.
    // TA1 Linter as Law — https://prickles.org/tenet/linter-as-law/TA1 (also covers: F5)
    // Not carried over: oxfmt replaces Prettier, and `pnpm quality` runs `oxfmt --check` (ADR-0017).

    // T2 No Escape Hatches — https://prickles.org/tenet/no-escape-hatches/T2
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "off",
    // T2 (also covers: F2, F5)
    "typescript/explicit-function-return-type": "error",
    // T2 (also covers: TA1)
    "typescript/ban-ts-comment": "error",
    // F4 Simplicity — https://prickles.org/tenet/simplicity/F4 (also covers: T2)
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],

    // F6 Encapsulation — https://prickles.org/tenet/encapsulation/F6
    "no-param-reassign": "error",

    // F4 Simplicity (also covers: F5, P5)
    "no-console": ["error", { "allow": ["error"] }],
    // F4 (also covers: F5)
    "no-multi-str": "error",

    // F1 Single Responsibility — https://prickles.org/tenet/single-responsibility-principle/F1 (also covers: S2)
    "max-lines-per-function": [
      "error",
      { "max": 15, "skipBlankLines": true, "skipComments": true }
    ],
    // F1 (also covers: S2, F4)
    "max-lines": [
      "error",
      { "max": 150, "skipBlankLines": true, "skipComments": true }
    ],

    // S2 Cyclomatic Caps — https://prickles.org/tenet/cyclomatic-caps/S2 (also covers: F1, F4)
    "complexity": ["error", 3],
    // S2 (also covers: S4)
    "max-depth": ["error", 3],
    // S2 (also covers: S4)
    "max-nested-callbacks": ["error", 3],
    // S2 (also covers: F1, F4)
    "max-statements": ["error", 10],
    // S3 Parameter Object — https://prickles.org/tenet/parameter-object/S3 (also covers: S2, F1)
    "max-params": ["error", 3],

    // F5 Self-Documenting Code — https://prickles.org/tenet/self-documenting-code/F5
    "no-inline-comments": "error",
    // F5 (also covers: F4)
    "no-warning-comments": [
      "error",
      { "terms": ["todo", "fixme", "xxx", "hack"] }
    ],
    // F5
    "stylistic/line-comment-position": [
      "error",
      { "position": "above", "ignorePattern": "$^" }
    ],
    // F5
    "stylistic/multiline-comment-style": ["error", "starred-block"],

    // P5 Shift-Left Quality — https://prickles.org/tenet/shift-left-quality/P5 (a11y safety net in JSX — also covers: TS5 Structural Assertions)
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    // F3 Don't Repeat Yourself — https://prickles.org/tenet/dont-repeat-yourself/F3 (also covers: TA2)
    "sonarjs/no-duplicate-string": ["error", { "threshold": 3 }],
    // F3 (also covers: TA2)
    "sonarjs/no-identical-functions": "error",
    // F3
    "sonarjs/no-identical-expressions": "error",
    // S5 Inline-First — https://prickles.org/tenet/inline-first/S5 (also covers: F4)
    "sonarjs/prefer-immediate-return": "error",
    // S5 (also covers: F4)
    "sonarjs/prefer-single-boolean-return": "error",
    // S5 (also covers: F4)
    "sonarjs/no-inverted-boolean-check": "error",
    // F4 (also covers: S4)
    "sonarjs/no-collapsible-if": "error",
    // F4 (also covers: S5)
    "sonarjs/no-redundant-boolean": "error",
    // F4
    "sonarjs/no-unused-collection": "error",
    // F4
    "sonarjs/no-gratuitous-expressions": "error",

    // A2 Three-Tier Hoisting — https://prickles.org/tenet/three-tier-hoisting/A2 (also covers: F1)
    "unicorn/consistent-function-scoping": "error",
    // TA1 Linter as Law
    "unicorn/no-abusive-eslint-disable": "error",
    // F4 Simplicity (also covers: S5)
    "unicorn-js/no-for-each": "error",
    "unicorn-js/no-for-loop": "error",
    // S4 Guard Clauses — https://prickles.org/tenet/guard-clauses/S4 (also covers: F4)
    "unicorn/no-lonely-if": "error",
    // S5 (also covers: F4)
    "unicorn/no-negated-condition": "error",
    // F4 (also covers: S5)
    "unicorn/no-nested-ternary": "error",
    // F4
    "unicorn/no-useless-spread": "error",
    "unicorn/no-useless-undefined": "error",
    // S5 (also covers: F4)
    "unicorn/prefer-array-find": "error",
    // F4
    "unicorn/prefer-array-flat": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/prefer-modern-math-apis": "error",
    "unicorn/prefer-negative-index": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-object-from-entries": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-spread": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/prefer-string-starts-ends-with": "error",
    "unicorn/prefer-string-trim-start-end": "error",
    // S5 (also covers: F4)
    "unicorn-js/prefer-switch": ["error", { "minimumCases": 3 }],
    // S5 (also covers: F4)
    "unicorn/prefer-ternary": "error",
    // F4
    "unicorn/prefer-type-error": "error",
    "unicorn/throw-new-error": "error",

    // F2 Intention-Revealing Names — https://prickles.org/tenet/intention-revealing-names/F2 (also covers: A1)
    "unicorn/filename-case": [
      "error",
      { "case": "kebabCase", "ignore": ["^README\\.md$"] }
    ],

    // A2 Three-Tier Hoisting — https://prickles.org/tenet/three-tier-hoisting/A2 (also covers: A3)
    // Not carried over: oxlint has no import/no-restricted-paths; no-restricted-imports in argo.json guards the client lib/generic and lib/product folders instead.
    // Argo's own import boundaries, D1 to D11 in argo.json, take this rule's place (ADR-0017).
    // A3 Stable Dependencies — https://prickles.org/tenet/stable-dependencies-principle/A3 (also covers: A11)
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.mts"],
      "rules": {
        "constructor-super": "off",
        "getter-return": "off",
        "no-class-assign": "off",
        "no-const-assign": "off",
        "no-dupe-class-members": "off",
        "no-dupe-keys": "off",
        "no-func-assign": "off",
        "no-import-assign": "off",
        "no-new-native-nonconstructor": "off",
        "no-obj-calls": "off",
        "no-redeclare": "off",
        "no-setter-return": "off",
        "no-this-before-super": "off",
        "no-unreachable": "off",
        "no-unsafe-negation": "off",
        "no-var": "error",
        "no-with": "off",
        "prefer-const": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error"
      }
    }
  ]
}
