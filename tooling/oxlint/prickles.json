  "env": { "builtin": true },
  "settings": { "react": { "version": "999.999.999" } },
  "ignorePatterns": ["node_modules/**"],
  "rules": {
    // tseslint.configs.recommended and sonarjs.configs.recommended, expanded by @oxlint/migrate.
    "no-array-constructor": "error",
