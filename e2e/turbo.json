{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  // native/ holds the Maestro flows, which run by hand and never in these tasks (ADR 0011).
  // check-types depends on this package's own transit, so native/ leaves transit too.
  "tasks": {
    "check-types": { "inputs": ["$TURBO_EXTENDS$", "!native/**"] },
    "test:web": { "inputs": ["$TURBO_EXTENDS$", "!native/**"] },
    "test:electron": { "inputs": ["$TURBO_EXTENDS$", "!native/**"] },
    "transit": { "inputs": ["$TURBO_EXTENDS$", "!native/**"] }
  }
}
