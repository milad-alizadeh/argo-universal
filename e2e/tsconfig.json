{
  "extends": "@repo/typescript/node.json",
  // The fixtures import the mock CLIs, whose relative imports end in `.ts`.
  "compilerOptions": {
    // The Engine's router types pull in React's DOM globals, so the DOM lib is on and a page callback narrows its element.
    "lib": ["es2025", "DOM"],
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report"]
}
