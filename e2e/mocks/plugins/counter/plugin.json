{
  "id": "counter",
  "name": "Counter",
  "version": "1.0.0",
  "engines": {
    "argo": ">=0.0.0 <2"
  },
  "main": "index.js",
  "icon": {
    "sf": "puzzlepiece",
    "material": "extension"
  },
  "contributes": {
    "nav": [
      {
        "id": "counter",
        "title": "Counter",
        "path": "/"
      }
    ],
    "slots": [
      "argo/project/details/v1",
      "argo/session/row/v1",
      "argo/session/activity/v1",
      "argo/session/bar/v1"
    ],
    "declared": {
      "argo/session/header/v1": [
        {
          "id": "open-counter",
          "label": "Open Counter",
          "icon": { "sf": "plus.circle", "material": "add_circle" },
          "placement": "header",
          "target": { "type": "page", "path": "/" }
        },
        {
          "id": "toggle-counter-card",
          "label": "Toggle Counter card",
          "icon": { "sf": "square.stack", "material": "dashboard" },
          "placement": "menu",
          "target": { "type": "card", "cardId": "counter-card" }
        },
        {
          "id": "toggle-notes-card",
          "label": "Toggle Notes card",
          "icon": { "sf": "note.text", "material": "notes" },
          "placement": "menu",
          "target": { "type": "card", "cardId": "notes" }
        }
      ],
      "argo/session/workbench/v1": [
        {
          "id": "counter-card",
          "title": "Counter card",
          "icon": { "sf": "square.stack", "material": "dashboard" },
          "page": "/card",
          "tab": "/card/full"
        },
        {
          "id": "notes",
          "title": "Notes",
          "icon": { "sf": "note.text", "material": "notes" },
          "page": "/notes",
          "tab": "/notes/full"
        }
      ]
    }
  }
}
