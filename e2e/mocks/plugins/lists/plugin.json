    "declared": {
      "argo/session/workbench/v1": [
        {
          "id": "notes",
          "title": "Notes",
          "icon": {
            "sf": "note.text",
            "material": "note"
          },
          "page": "/notes",
          "tab": "/notes/full"
        }
      ]
    }
