{
  "id": "lists",
  "name": "Lists",
  "version": "1.0.0",
  "engines": {
    "argo": ">=0.0.0 <2"
  },
  "main": "index.js",
  "icon": {
    "sf": "puzzlepiece",
    "material": "extension"
  },
  "contributes": {
    "nav": [
      {
        "id": "lists",
        "title": "Lists",
        "path": "/lists"
      },
      {
        "id": "issues",
        "title": "Issues",
        "path": "/issues"
      }
    ],
    "slots": [],
    "declared": {
      "argo/session/header/v1": [
        {
          "id": "open-notes-switch",
          "label": "Open Notes switch",
          "icon": {
            "sf": "note.text",
            "material": "notes"
          },
          "placement": "menu",
          "target": {
            "type": "page",
            "path": "/lists/notes-switch"
          }
        },
        {
          "id": "toggle-notes-card",
          "label": "Toggle Notes card",
          "icon": {
            "sf": "note.text",
            "material": "notes"
          },
          "placement": "menu",
          "target": {
            "type": "card",
            "cardId": "notes"
          }
        }
      ],
      "argo/session/workbench/v1": [
        {
          "id": "notes",
          "title": "Notes",
          "icon": {
            "sf": "note.text",
            "material": "notes"
          },
          "page": "/notes",
          "tab": "/notes/full"
        }
      ]
    }
  }
}
