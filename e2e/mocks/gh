#!/bin/sh
if [ "$1" = "auth" ] && [ "$2" = "status" ]; then
  exit 0
fi
if [ "$1" = "issue" ] && [ "$2" = "list" ]; then
  printf '%s\n' '[{"number":42,"title":"Fixture issue from GitHub","state":"OPEN","labels":[{"name":"fixture"}],"assignees":[{"login":"octocat"}],"url":"https://github.com/owner/repository/issues/42"}]'
  exit 0
fi
if [ "$1" = "issue" ] && [ "$2" = "view" ]; then
  printf '%s\n' '{"number":42,"title":"Fixture issue from GitHub","state":"OPEN","body":"This Issue came from the fixture gh executable.","labels":[{"name":"fixture"}],"assignees":[{"login":"octocat"}],"url":"https://github.com/owner/repository/issues/42"}'
  exit 0
fi
if [ "$1" = "issue" ] && { [ "$2" = "close" ] || [ "$2" = "reopen" ]; }; then
  exit 0
fi
printf 'Unsupported fixture gh command: %s\n' "$*" >&2
exit 2
