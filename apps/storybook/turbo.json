{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // .storybook/main.ts imports the SF Symbol plugin and the sync-port helper from tools/ and serves the App's fonts and canvaskit.wasm, none of which is a package dependency.
    "test:stories": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/tools/sf-symbols/**",
        "$TURBO_ROOT$/tools/storybook-sync-port.js",
        "$TURBO_ROOT$/apps/universal-app/public/**"
      ]
    }
  }
}
