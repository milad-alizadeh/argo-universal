{
  "extends": "@repo/typescript/react-native.json",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    // The kit's React Native typing for the inert prop, which its components use.
    "../../packages/kit/src/view-inert.d.ts",
    // Prism's DOM-free core, which the package itself leaves untyped.
    "../../packages/kit/src/primitives/content/code/code-highlight/prism-core.d.ts"
  ],
  // expo/tsconfig.base excluded these; the shared base does not.
  "exclude": ["node_modules", "android", "ios"]
}
