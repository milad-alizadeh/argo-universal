{
  "id": "sign-in-combined",
  "name": "Combined sign-in",
  "version": "0.0.1",
  "engines": {
    "argo": ">=0.0.0 <1.0.0"
  },
  "main": "index.tsx",
  "icon": {
    "sf": "key",
    "material": "key"
  },
  "contributes": {
    "nav": [
      {
        "id": "items",
        "title": "Items",
        "path": "/"
      }
    ],
    "accounts": [
      {
        "host": "api.service.example",
        "page": "/sign-in"
      }
    ],
    "operations": [
      {
        "name": "signIn",
        "label": "Sign in",
        "description": "Checks a pasted token and signs in with it.",
        "policy": "allow",
        "tier": "act",
        "params": {
          "token": {
            "type": "string",
            "description": "The pasted API token.",
            "secret": true
          },
          "flow": {
            "type": "string",
            "description": "The selected sign-in flow.",
            "required": true
          },
          "email": {
            "type": "string",
            "description": "The email for Basic authentication."
          }
        }
      },
      {
        "name": "cancelSignIn",
        "label": "Cancel sign-in",
        "description": "Cancels the selected sign-in.",
        "policy": "allow",
        "tier": "act",
        "params": {
          "flow": {
            "type": "string",
            "description": "The selected sign-in flow.",
            "required": true
          }
        }
      }
    ]
  },
  "capabilities": [
    {
      "kind": "fetch",
      "host": "api.service.example",
      "reason": "Reads the fixture service."
    }
  ]
}
