import { readFile, writeFile } from 'node:fs/promises';
import { createRequire } from 'node:module';
import { dirname, join } from 'node:path';

// The App draws icons through expo-symbols, so its names are the lists: Material from its glyph map, SF from the types it accepts.
const client = createRequire(
  new URL('../../../client/package.json', import.meta.url),
);

const expoSymbols = client.resolve('expo-symbols');

const outputDirectory = new URL('../../src/plugins/', import.meta.url);

async function materialNames(): Promise<string[]> {
  const glyphs = join(dirname(expoSymbols), 'android', 'symbols.json');

  return Object.keys(JSON.parse(await readFile(glyphs, 'utf8')));
}

// Each SF Symbols release's type extends the one before, so every quoted member is a name in the newest.
async function sfNames(): Promise<string[]> {
  const types = createRequire(expoSymbols).resolve('sf-symbols-typescript');
  const source = await readFile(join(dirname(types), 'index.d.ts'), 'utf8');

  return [...source.matchAll(/^ {2}\| '([^']+)'$/gmu)].map(
    ([, name]) => name ?? '',
  );
}

function moduleText(constant: string, names: string[]): string {
  const sorted = [...new Set(names)].sort();
  const lines = sorted.map((name) => `  ${JSON.stringify(name)},`);

  return [
    '// Generated by `pnpm --filter @repo/contracts generate:symbol-names` from the installed expo-symbols; do not edit.',
    `export const ${constant} = [`,
    ...lines,
    '] as const;',
    '',
  ].join('\n');
}

async function write(
  file: string,
  constant: string,
  names: string[],
): Promise<void> {
  await writeFile(new URL(file, outputDirectory), moduleText(constant, names));
}

await write(
  'material-symbol-names.gen.ts',
  'materialSymbolNames',
  await materialNames(),
);

await write('sf-symbol-names.gen.ts', 'sfSymbolNames', await sfNames());
