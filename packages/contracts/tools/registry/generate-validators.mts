import { readFile, writeFile } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';
import Ajv from 'ajv';
import addFormats from 'ajv-formats';
import standaloneCode from 'ajv/dist/standalone/index.js';
import { buildSync } from 'esbuild';
import { installedAgentSchema } from '../../src/agents/upstream/installed-agent-schema';
import { registryAgentSchema } from '../../src/agents/upstream/schema';

const validator = addFormats(
  new Ajv({ strict: false, code: { source: true, esm: true, lines: true } }),
);

validator.addSchema(registryAgentSchema);

validator.addSchema(installedAgentSchema, 'argo:installed-agent');

const standalone = standaloneCode(validator, {
  validateRegistryEntry: registryAgentSchema.$id,
  validateInstalledAgent: 'argo:installed-agent',
});

const bundled = buildSync({
  absWorkingDir: fileURLToPath(new URL('../../../..', import.meta.url)),
  stdin: {
    contents: standalone,
    resolveDir: fileURLToPath(new URL('../..', import.meta.url)),
    sourcefile: 'registry-validators.js',
  },
  bundle: true,
  platform: 'browser',
  format: 'esm',
  write: false,
});

const javascript = bundled.outputFiles[0]?.text;

if (!javascript)
  throw new Error('Registry validator generation produced no JavaScript.');

const generatedNotice =
  '// Generated by packages/contracts/tools/registry/generate-validators.mts from the official ACP Registry and Installed Agent schemas.\n';

const declarations = `import type { ACPAgent } from './registry.gen';\nimport type { AgentServer } from '../servers';\nexport declare function validateRegistryEntry(value: unknown): value is ACPAgent;\nexport declare function validateInstalledAgent(value: unknown): value is AgentServer;\n`;

const outputFolder = new URL('../../src/agents/upstream/', import.meta.url);

const checking = process.argv.includes('--check');

async function emit(file: string, source: string): Promise<void> {
  const output = new URL(file, outputFolder);

  if (!checking) return writeFile(output, generatedNotice + source);

  if ((await readFile(output, 'utf8')) !== generatedNotice + source)
    throw new Error(
      'Registry validators are stale. Run node --import tsx packages/contracts/tools/registry/generate-validators.mts.',
    );
}

await emit('registry-validators.gen.js', javascript);

await emit('registry-validators.gen.d.ts', declarations);
