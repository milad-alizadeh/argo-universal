{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AuthStatusUpdateNotification",
  "definitions": {
    "AuthStatusUpdateNotification": {
      "type": "object",
      "properties": {
        "authStatus": {
          "$ref": "#/definitions/AuthStatus"
        }
      },
      "required": [
        "authStatus"
      ]
    },
    "AuthStatus": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/AuthStatusKind"
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "account": {
          "$ref": "#/definitions/AuthStatusAccount"
        },
        "vendor": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "kind",
        "label"
      ]
    },
    "AuthStatusKind": {
      "type": "string",
      "enum": [
        "account",
        "api_key",
        "gateway",
        "external",
        "none"
      ]
    },
    "AuthStatusAccount": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "plan": {
          "type": "string"
        }
      }
    }
  }
}
