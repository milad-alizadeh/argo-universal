{
  "name": "@repo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#plugin-argo-calls": "./src/plugins/argo-calls.ts",
    "#plugin-identifier": "./src/plugins/plugin-identifier.ts",
    "#plugin-assets": "./src/plugins/assets.ts",
    "#plugin-wire-slot": "./src/plugins/wire-slot.ts",
    "#plugin-wire-events": "./src/plugins/wire-events.ts",
    "#plugin-replaceable-slot-id": "./src/plugins/replaceable-slot-id.ts",
    "#plugin-surface": "./src/plugins/surface.ts",
    "#plugin-wire-json": "./src/plugins/wire-json.ts",
    "#plugin-query-normalisation": "./src/plugins/query-normalisation.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./registry-schema": "./src/agents/upstream/schema.ts",
    "./plugins": "./src/plugins/plugins.ts",
    "./plugins/runtime": "./src/plugins/runtime.ts",
    "./plugins/argo-calls": "./src/plugins/argo-calls.ts",
    "./plugins/query-results": "./src/plugins/query-results.ts",
    "./plugins/query-normalisation": "./src/plugins/query-normalisation.ts",
    "./plugins/argo-api": "./src/plugins/argo-api.ts",
    "./plugins/assets": "./src/plugins/assets.ts",
    "./plugins/hook-protocol": "./src/plugins/hook-protocol.ts",
    "./plugins/hooks": "./src/plugins/hooks.ts",
    "./plugins/wire-limits": "./src/plugins/wire-limits.ts",
    "./plugins/replaceable-fixtures": "./mocks/replaceable-slots.ts",
    "./plugins/replaceable": "./src/plugins/replaceable.ts",
    "./plugins/wire": "./src/plugins/wire.ts",
    "./plugins/wire-patch": "./src/plugins/wire-patch.ts",
    "./plugins/wire-fixtures": "./src/plugins/wire-fixtures.ts",
    "./plugins/sf-symbol-names": "./src/plugins/sf-symbol-names.gen.ts",
    "./plugins/material-symbol-names": "./src/plugins/material-symbol-names.gen.ts",
    "./plugins/action-list-props": "./src/plugins/action-list-props.ts",
    "./plugins/kit": "./src/plugins/kit.ts",
    "./plugins/replacement-tree": "./src/plugins/replacement-tree.ts",
