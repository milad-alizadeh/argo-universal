{
  "name": "@repo/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#plugin-identifier": "./src/plugins/plugin-identifier.ts",
    "#plugin-wire-slot": "./src/plugins/wire-slot.ts",
    "#plugin-wire-events": "./src/plugins/wire-events.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./registry-schema": "./src/agents/upstream/schema.ts",
    "./plugins": "./src/plugins/plugins.ts",
    "./plugins/runtime": "./src/plugins/runtime.ts",
    "./plugins/argo-calls": "./src/plugins/argo-calls.ts",
    "./plugins/assets": "./src/plugins/assets.ts",
    "./plugins/hook-protocol": "./src/plugins/hook-protocol.ts",
    "./plugins/wire-limits": "./src/plugins/wire-limits.ts",
    "./plugins/wire": "./src/plugins/wire.ts",
    "./plugins/wire-patch": "./src/plugins/wire-patch.ts",
    "./plugins/wire-fixtures": "./src/plugins/wire-fixtures.ts",
    "./plugins/sf-symbol-names": "./src/plugins/sf-symbol-names.gen.ts",
    "./plugins/material-symbol-names": "./src/plugins/material-symbol-names.gen.ts",
    "./plugins/wire-node-key": "./src/plugins/wire-node-key.ts"
  },
  "scripts": {
    "generate:registry": "node tools/registry/generate.mts && json2ts -i src/agents/upstream/registry.published.schema.gen.json -o src/agents/upstream/registry.gen.ts --cwd src/agents/upstream --unknownAny --bannerComment '/* Generated from ACP Registry 33a1a101ef68ab20a97624ac89d4b977eeac0daf schema and publisher literal by json-schema-to-typescript 16.0.0. */'",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript": "workspace:*",
    "@repo/vitest": "workspace:*",
    "@types/node": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
