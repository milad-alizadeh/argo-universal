import { access, readFile, writeFile } from 'node:fs/promises';
import { createRequire } from 'node:module';
import { dirname, join } from 'node:path';
import { iconSymbols } from '@repo/contracts/kit-symbols';

/*
 * Writes `material-images.gen.ts`: every Material name an Argo icon holds, as a static import of its
 * @expo/material-symbols XML drawing, so Metro bundles only the drawings Argo draws. `iconSymbols` stays
 * the one hand-kept table; a name the package has no drawing for is listed as undrawn instead.
 */

// The header overflow's vertical ⋯ (`overflowIcon`), which no Argo icon names.
const extraNames = ['more_vert'];

// Argo's own drawings of names the package lacks (assets/README.md).
const ownDrawings = new Map([['expand_more', '../assets/expand-more.xml']]);

const output = new URL(
  '../../src/symbols/material-images/material-images.gen.ts',
  import.meta.url,
);

const require = createRequire(import.meta.url);

const iconsDirectory = dirname(
  require.resolve('@expo/material-symbols/add.xml'),
);

function materialNames(): string[] {
  const names = Object.values(iconSymbols).flatMap((source) =>
    'material' in source ? [source.material] : [],
  );

  return [...new Set([...names, ...extraNames])].sort();
}

async function hasDrawing(name: string): Promise<boolean> {
  try {
    await access(join(iconsDirectory, `${name}.xml`));

    return true;
  } catch {
    return false;
  }
}

function drawingPath(name: string, packaged: boolean): string | undefined {
  return packaged
    ? `@expo/material-symbols/${name}.xml`
    : ownDrawings.get(name);
}

const identifier = (name: string): string =>
  `material_${name.replaceAll(/\W/gu, '_')}`;

interface Drawings {
  drawn: [name: string, path: string][];
  undrawn: string[];
}

async function drawings(): Promise<Drawings> {
  const result: Drawings = { drawn: [], undrawn: [] };

  for (const name of materialNames()) {
    const path = drawingPath(name, await hasDrawing(name));

    if (path) result.drawn.push([name, path]);
    else result.undrawn.push(name);
  }

  return result;
}

const header =
  '// Generated by `pnpm --filter @repo/kit generate:material-images` from `iconSymbols`; do not edit.';

function imageTable(drawn: Drawings['drawn']): string[] {
  return [
    "// Each Material name an Argo icon holds, as its Android XML drawing for Expo UI's Icon.",
    'export const materialImages = {',
    ...drawn.map(([name]) => `  ${name}: ${identifier(name)},`),
    '} as const;',
  ];
}

function moduleText({ drawn, undrawn }: Drawings): string {
  return [
    header,
    ...drawn.map(
      ([name, path]) => `import ${identifier(name)} from '${path}';`,
    ),
    '',
    ...imageTable(drawn),
    '',
    "// Material names with no drawing; their icons stay drawn by Argo's Icon.",
    `export const undrawnMaterialNames = ${JSON.stringify(undrawn)} as const;`,
    '',
  ].join('\n');
}

const text = moduleText(await drawings());

if (process.argv.includes('--check')) {
  if ((await readFile(output, 'utf8')) !== text)
    throw new Error(
      'material-images.gen.ts is stale: run `pnpm --filter @repo/kit generate:material-images`',
    );
} else {
  await writeFile(output, text);
}
