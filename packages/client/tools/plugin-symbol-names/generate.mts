import { readFile, writeFile } from 'node:fs/promises';
import { createRequire } from 'node:module';
import { dirname, join } from 'node:path';

/*
 * The App draws icons through expo-symbols, so the App writes the lists Plugin manifests are checked
 * against: Material from expo-symbols' glyph map, SF from the SF Symbols release the oldest supported
 * Apple system ships: iOS 18.0 and macOS 15.0 both have SF Symbols 6.0 (ADR-0029).
 */
const oldestSfRelease = '6_0';

const require = createRequire(import.meta.url);

const expoSymbols = require.resolve('expo-symbols');

const outputDirectory = new URL(
  '../../../contracts/src/plugins/',
  import.meta.url,
);

async function materialNames(): Promise<string[]> {
  const glyphs = join(dirname(expoSymbols), 'android', 'symbols.json');

  return Object.keys(JSON.parse(await readFile(glyphs, 'utf8')));
}

// Each release's type extends the one before, so the names are every quoted member up to the oldest supported release.
async function sfNames(): Promise<string[]> {
  const types = require.resolve('sf-symbols-typescript');
  const source = await readFile(join(dirname(types), 'index.d.ts'), 'utf8');
  const end = source.indexOf(`export type SFSymbols${nextRelease(source)} =`);

  return quotedMembers(source.slice(0, end));
}

// The release after the oldest supported one, where its names stop.
function nextRelease(source: string): string {
  const releases = [
    ...source.matchAll(/^export type SFSymbols(\d+_\d+) =/gmu),
  ].map(([, release]) => release);

  const next = releases[releases.indexOf(oldestSfRelease) + 1];

  if (!releases.includes(oldestSfRelease) || !next)
    throw new Error(`SF Symbols ${oldestSfRelease} not found`);

  return next;
}

function quotedMembers(source: string): string[] {
  return [...source.matchAll(/^ {2}\| '([^']+)'$/gmu)].flatMap(([, name]) =>
    name ? [name] : [],
  );
}

function moduleText(constant: string, names: string[]): string {
  const sorted = [...new Set(names)].sort();

  return [
    '// Generated by `pnpm --filter @repo/client generate:plugin-symbol-names`; do not edit.',
    `export const ${constant} = [`,
    ...sorted.map((name) => `  ${JSON.stringify(name)},`),
    '] as const;',
    '',
  ].join('\n');
}

async function write(
  file: string,
  constant: string,
  names: string[],
): Promise<void> {
  if (names.length === 0) throw new Error(`No names for ${constant}`);

  await writeFile(new URL(file, outputDirectory), moduleText(constant, names));
}

await write(
  'material-symbol-names.gen.ts',
  'materialSymbolNames',
  await materialNames(),
);

await write('sf-symbol-names.gen.ts', 'sfSymbolNames', await sfNames());
