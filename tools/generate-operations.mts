import { execFileSync } from 'node:child_process';
import { readFile, writeFile } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';
import {
  operations,
  type OperationDefinition,
} from '@repo/contracts/operations';

const entries = Object.values(operations);

const preamble = `// Generated by tools/generate-operations.mts from the Operation registry.\nimport { operations } from '@repo/contracts/operations';\nimport { authenticatedAppProcedure, publicProcedure, router } from '../rpc';\nimport type { OperationRunner } from './runner';\n`;

// An id is a noun then a verb, or a noun, a group and a verb (`plugin.draft.show`), which nests one router deeper.
const routers = routerSource(entries, 0);

function routerSource(
  group: readonly OperationDefinition[],
  depth: number,
): string {
  const names = [...new Set(group.map(({ id }) => id.split('.')[depth]))];

  return names
    .map((name) => {
      const members = group.filter(({ id }) => id.split('.')[depth] === name);
      const [leaf] = members;

      if (members.length === 1 && leaf?.id.split('.').length === depth + 1)
        return `'${name}': ${procedureSource(leaf)},`;

      if (members.some(({ id }) => id.split('.').length === depth + 1))
        throw new Error(
          `Operation id ${name} is both a verb and a group at depth ${depth}.`,
        );

      return `${name}: router({\n${routerSource(members, depth + 1)}\n}),`;
    })
    .join('\n');
}

function procedureSource({ id, tier, policy }: OperationDefinition): string {
  const procedure = procedureName({ tier, policy });

  return `${procedure}.input(operations['${id}'].params).output(operations['${id}'].result).${tier === 'read' ? 'query' : 'mutation'}(({ input, ctx }) => runner.run({ kind: 'app', id: '${id}', params: input, connectionSignal: ctx.connection.signal }))`;
}

const output = new URL(
  '../packages/engine/src/operations/router.gen.ts',
  import.meta.url,
);

const source = `${preamble}\nexport function generatedOperations(runner: OperationRunner) {\nreturn {\n${routers}\n};\n}\n`;

const formatted = execFileSync(
  fileURLToPath(new URL('../node_modules/.bin/oxfmt', import.meta.url)),
  ['--stdin-filepath', fileURLToPath(output).replace('.gen.ts', '.ts')],
  { input: source, encoding: 'utf8' },
);

if (process.argv.includes('--check')) {
  if ((await readFile(output, 'utf8')) !== formatted)
    throw new Error(
      'Operation procedures are stale. Run node --import tsx tools/generate-operations.mts.',
    );
} else {
  await writeFile(output, formatted);
}

function procedureName({
  tier,
  policy,
}: Pick<OperationDefinition, 'tier' | 'policy'>): string {
  return tier === 'read' && policy !== 'person-only'
    ? 'publicProcedure'
    : 'authenticatedAppProcedure';
}
