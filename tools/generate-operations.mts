import { execFileSync } from 'node:child_process';
import { readFile, writeFile } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';
import { operations } from '@repo/contracts/operations';

const entries = Object.values(operations);

const preamble = `// Generated by tools/generate-operations.mts from the Operation registry.\nimport { operations } from '@repo/contracts/operations';\nimport { publicProcedure, router } from '../rpc';\nimport type { Operations } from './operations';\n`;

const nouns = [...new Set(entries.map(({ id }) => id.split('.')[0]))];

const routers = nouns
  .map((noun) => {
    const procedures = entries
      .filter(({ id }) => id.startsWith(`${noun}.`))
      .map(({ id, tier }) => {
        const verb = id.split('.')[1];

        return `'${verb}': publicProcedure.input(operations['${id}'].params).output(operations['${id}'].result).${tier === 'read' ? 'query' : 'mutation'}(({ input }) => engine.runApp('${id}', input)),`;
      })
      .join('\n');

    return `${noun}: router({\n${procedures}\n}),`;
  })
  .join('\n');

const output = new URL(
  '../packages/engine/src/operations/router.gen.ts',
  import.meta.url,
);

const source = `${preamble}\nexport function generatedOperations(engine: Operations) {\nreturn {\n${routers}\n};\n}\n`;

const formatted = execFileSync(
  fileURLToPath(new URL('../node_modules/.bin/oxfmt', import.meta.url)),
  ['--stdin-filepath', fileURLToPath(output).replace('.gen.ts', '.ts')],
  { input: source, encoding: 'utf8' },
);

if (process.argv.includes('--check')) {
  if ((await readFile(output, 'utf8')) !== formatted)
    throw new Error(
      'Operation procedures are stale. Run node --import tsx tools/generate-operations.mts.',
    );
} else {
  await writeFile(output, formatted);
}

execFileSync(
  process.execPath,
  [
    '--import',
    'tsx',
    fileURLToPath(
      new URL(
        '../packages/contracts/tools/registry/generate-validators.mts',
        import.meta.url,
      ),
    ),
    ...process.argv.slice(2),
  ],
  { stdio: 'inherit' },
);
