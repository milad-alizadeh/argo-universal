{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      // Expo replaces Next.js (ADR 0001), so builds write dist/ instead of .next/.
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // Strict env mode hides the Server home, port, and Expo web URL from dev scripts otherwise.
      "passThroughEnv": [
        "ARGO_*",
        "EXPO_PUBLIC_ARGO_MACHINE_LOG",
        "EXPO_PUBLIC_ARGO_MACHINE_INSPECT"
      ]
    },
    "inspect": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["CI"]
    }
  }
}
