{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  // No cacheDir, so every worktree of a clone shares the main worktree's .turbo/cache (Turborepo caching guide).
  // .turbo/config.json from `turbo link` stays in the main worktree, so the team lives here for linked worktrees to reach the Remote Cache.
  "remoteCache": { "teamSlug": "miladalizadehs-projects" },
  "futureFlags": {
    // --affected selects a task only when a changed file matches its inputs, so a README edit selects nothing.
    "affectedUsingTaskInputs": true
  },
  // No task reads a README, so every task leaves them out. Other Markdown stays in: mocks/agent/release-notes.md is an e2e fixture.
  "tasks": {
    "@repo/contracts#generate:plugin-kit": {
      "inputs": ["$TURBO_DEFAULT$", "!**/README.md", "!**/*.test.ts"],
      "outputs": ["$TURBO_ROOT$/packages/plugin-kit/src/components.gen.d.ts"]
    },
    "build": {
      "dependsOn": ["^build", "@repo/contracts#generate:plugin-kit"],
      // The web export bundles no tests, so a test edit keeps the export and the e2e shards cached.
      // Only build drops test stories: Storybook's tests read @repo/client's through transit.
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!**/README.md",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.test.mts",
        "!**/*.test.stories.tsx"
      ],
      // Expo replaces Next.js (ADR 0001), so builds write dist/ instead of .next/.
      "outputs": ["dist/**"]
    },
    // Through transit, type checks run in parallel and a dependency's test edit keeps its dependents cached (Turborepo TypeScript guide).
    "check-types": {
      "dependsOn": ["transit", "@repo/contracts#generate:plugin-kit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/README.md",
        "$TURBO_ROOT$/tools/plugin-typecheck.mts"
      ]
    },
    // Per-package Vitest runs so CI skips unchanged packages; the root vitest.config.ts stays for local runs (Turborepo Vitest guide).
    "test": {
      "dependsOn": ["transit", "@repo/contracts#generate:plugin-kit"],
      "env": ["VITEST_MAX_WORKERS"],
      "inputs": ["$TURBO_DEFAULT$", "!**/README.md"],
      "outputs": []
    },
    // Storybook's browser tests, apart from test so CI runs them in their own sharded job; a shard's --shard argument feeds its hash.
    "test:stories": {
      "dependsOn": ["transit", "@repo/contracts#generate:plugin-kit"],
      "env": ["VITEST_MAX_WORKERS"],
      "passThroughEnv": ["ARGO_BROWSER_SUITE_LOCK_HELD"],
      "inputs": ["$TURBO_DEFAULT$", "!**/README.md"],
      "outputs": []
    },
    // @repo/e2e lists the Server, App, and Desktop as dependencies, so their sources and the web export feed this hash (Turborepo Playwright guide).
    "test:web": {
      "dependsOn": ["^build", "@repo/contracts#generate:plugin-kit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/README.md"],
      // A CI shard's blob report replays from the cache too, so the merged HTML report stays whole.
      "outputs": ["playwright-report/**", "blob-report/**"],
      "env": ["ARGO_E2E_SHARD", "ARGO_E2E_FOCUS"],
      "passThroughEnv": ["PLAYWRIGHT_*", "ARGO_BROWSER_SUITE_LOCK_HELD"]
    },
    "test:electron": {
      "dependsOn": ["^build", "^package"],
      "inputs": ["$TURBO_DEFAULT$", "!**/README.md"],
      "outputs": ["playwright-report/**"],
      // ARGO_E2E_FOCUS=1 runs the @needs-focus scenarios; without it in the hash, turbo strips it and they skip.
      "env": ["ARGO_E2E_FOCUS"],
      // xvfb-run hands Electron its display through XAUTHORITY.
      "passThroughEnv": [
        "PLAYWRIGHT_*",
        "XAUTHORITY",
        "ARGO_BROWSER_SUITE_LOCK_HELD"
      ]
    },
    // Electron Forge's package; e2e launches Electron from .vite/build, so the 300 MB out/ stays out of the shared cache.
    "package": {
      "dependsOn": ["^transit", "@repo/contracts#generate:plugin-kit"],
      // The package bundles no tests, so a test edit keeps it and the Electron e2e cached.
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/README.md",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.test.mts"
      ],
      "outputs": [".vite/build/**"]
    },
    // No package has this script; it only carries dependency hashes so a change in a dependency misses its dependents' test cache.
    // A package's own tests feed its test hash; leaving them out here keeps a dependency's test edit from missing its dependents' cache.
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/README.md",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.test.mts"
      ]
    },
    "dev": {
      "dependsOn": ["@repo/contracts#generate:plugin-kit"],
      "cache": false,
      "persistent": true,
      // Strict env mode hides the Server home, port, and Expo web URL from dev scripts otherwise.
      "passThroughEnv": ["ARGO_*"]
    }
  }
}
