{
  "minTokens": 50,
  "minLines": 5,
  "format": ["typescript", "tsx", "javascript"],
  "reporters": ["console"],
  "absolute": true,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.vite/**",
    "**/.expo/**",
    "**/*.stories.tsx",
    "packages/client/src/primitives/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/mocks/**",
    "**/*.mocks.*",
    "e2e/**",
    "tools/**",
    "**/*.gen.*",
    "**/.rnstorybook/storybook.requires.ts",
    "**/uniwind-types.d.ts",
    "packages/db/drizzle/**"
  ],
  "ignorePattern": [
    "Session\\w+(Input|Output),\\s+Session\\w+(Input|Output),\\s+SessionAnswer\\w+,"
  ]
}
